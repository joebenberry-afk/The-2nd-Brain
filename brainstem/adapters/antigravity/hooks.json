{
  "second-brain": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "powershell -ExecutionPolicy Bypass -File scripts/run-hook.ps1 -Event PreInvocation",
        "timeout": 30
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "powershell -ExecutionPolicy Bypass -File scripts/run-hook.ps1 -Event PostInvocation",
        "timeout": 30
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File scripts/run-hook.ps1 -Event PostToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "powershell -ExecutionPolicy Bypass -File scripts/run-hook.ps1 -Event Stop",
        "timeout": 30
      }
    ]
  }
}
