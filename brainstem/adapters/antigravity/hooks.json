{
  "second-brain": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "\"<POWERSHELL_EXE>\" -ExecutionPolicy Bypass -File \"<RUN_PS1>\" -Event PreInvocation",
        "timeout": 30
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "\"<POWERSHELL_EXE>\" -ExecutionPolicy Bypass -File \"<RUN_PS1>\" -Event PostInvocation",
        "timeout": 30
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"<POWERSHELL_EXE>\" -ExecutionPolicy Bypass -File \"<RUN_PS1>\" -Event PostToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "\"<POWERSHELL_EXE>\" -ExecutionPolicy Bypass -File \"<RUN_PS1>\" -Event Stop",
        "timeout": 30
      }
    ]
  }
}
