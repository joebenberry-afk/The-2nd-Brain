{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          { "type": "command", "command": "\"<BRAIN_EXE>\" hook claude-code", "timeout": 10 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "\"<BRAIN_EXE>\" hook claude-code", "timeout": 10 }
        ]
      }
    ]
  }
}
