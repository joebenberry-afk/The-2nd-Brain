+def ingest_worker_lifecycle(
+    home: Path | str,
+    *,
+    task_id: str,
+    packet_sha256: str,
+    host_session_id: str,
+    attempt_id: str,
+    project_id: str,
+    worktree_id: str,
+    callback_token: str,
+    host_generation: Any,
+    native_attempt_id: Any,
+    native_job_id: Any,
+    agent_id: Any,
