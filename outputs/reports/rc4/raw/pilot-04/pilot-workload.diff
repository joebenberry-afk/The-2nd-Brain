+
+        list_res = _run_vmem_cli(
+            ["list", "sess-cli-goodfilter", "--state", "RESIDENT", "--kind", "WORKER_FINDING",
+             "--json"],
+            brain_home,
+        )
+        assert list_res.returncode == 0
+        items = json.loads(list_res.stdout)
+        assert len(items) == 1
+        assert items[0]["obj_id"] == obj_id
+
