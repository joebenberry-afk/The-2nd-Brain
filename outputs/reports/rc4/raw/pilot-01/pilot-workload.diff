+def test_load_retention_config_defaults_and_fallback(tmp_path) -> None:
+    """load_retention_config docstring: absent/invalid config -> defaults
+    (undertested gap: no prior test exercised the parse/merge/fallback
+    branches directly, only the happy 'no config file' path via purge)."""
+    # 1. absent config file -> exact defaults
+    absent = ledger_mod.load_retention_config(tmp_path)
+    assert absent == ledger_mod._DEFAULT_RETENTION
+
+    # 2. malformed TOML -> falls back to defaults instead of raising
+    config_dir = tmp_path / "config"
+    config_dir.mkdir(parents=True, exist_ok=True)
+    (config_dir / "session-retention.toml").write_text(
+        "[retention\nthis is not valid toml", encoding="utf-8"
+    )
+    malformed = ledger_mod.load_retention_config(tmp_path)
+    assert malformed == ledger_mod._DEFAULT_RETENTION
+
+    # 3. valid partial override -> only recognized numeric/bool keys merge;
+    #    unknown keys and wrong-typed values are ignored, others keep defaults
+    (config_dir / "session-retention.toml").write_text(
+        """
+[retention]
+inactive_grace_minutes = 42
+preserve_pinned = false
+unknown_key = "ignored"
+max_single_session_bytes = "not-a-number"
+""",
+        encoding="utf-8",
+    )
+    partial = ledger_mod.load_retention_config(tmp_path)
+    assert partial["inactive_grace_minutes"] == 42
+    assert partial["preserve_pinned"] is False
+    assert partial["max_single_session_bytes"] == ledger_mod._DEFAULT_RETENTION[
+        "max_single_session_bytes"
+    ]
+    assert "unknown_key" not in partial
